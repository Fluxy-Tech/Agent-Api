// Schema canônico do projeto inteiro. Agent-Api é o ÚNICO serviço que roda
// `prisma migrate` contra este banco. Os demais serviços (Desk-API, Desk-Worker,
// Inbound-Service, Outbound-Worker, Notification-Worker) têm seu próprio
// prisma/schema.prisma com um SUBCONJUNTO destes models, apontando para o mesmo
// DATABASE_URL, rodando apenas `prisma generate` — nunca `prisma migrate`.
// Qualquer alteração de coluna feita aqui precisa ser espelhada manualmente nos
// schemas reduzidos dos outros serviços.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- BETTER AUTH (core + plugins organization/admin) ----------

model User {
  id                        String             @id
  name                      String
  email                     String
  emailVerified             Boolean            @default(false)
  image                     String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  /// Flag de plataforma do plugin admin do Better Auth. role === "admin" ⇒
  /// Administrador global (ignora a matriz de permissões por organização).
  role                      String?
  banned                    Boolean?           @default(false)
  banReason                 String?
  banExpires                DateTime?
  sessions                  Session[]
  accounts                  Account[]
  members                   Member[]
  invitations               Invitation[]
  invitationMembersRedeemed InvitationMember[]
  queueMemberships          QueueMember[]
  assignedTickets           Ticket[]
  cardCrmComments           CardCrmComment[]
  calendarEventAnnotations  CalendarEventAnnotation[]
  campaignsRoutedToMe       Campaign[]         @relation("CampaignRouteToUser")

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy       String?
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id            String   @id
  name          String
  slug          String
  logo          String?
  createdAt     DateTime
  metadata      String?
  cnpj          String
  status        String?  @default("ACTIVE")
  /// Token de acesso à API externa (Fluxy Agents) — gerado sob demanda na tela
  /// de Acessos, nunca devolvido em claro depois de gerado (ver company-service.ts).
  tokenAcessApi String?  @unique

  members           Member[]
  invitations       Invitation[]
  invitationMembers InvitationMember[]
  agents            Agent[]
  whatsappChannels  Channel[]
  serviceIslands    ServiceIsland[]
  targets           Target[]
  tickets           Ticket[]
  ticketCounter     TicketCounter?
  campaigns         Campaign[]
  auditLogs         AuditLog[]
  errorLogs         ErrorLog[]
  crmToBusiness     CrmToBusiness?
  funil             Funil?
  calendar          CalendarOrganization?

  @@unique([slug])
  @@map("organization")
}

/// Role por organização. Better Auth (plugin organization) é dono deste campo a
/// nível de schema, por isso é String livre (não enum) — mesmo padrão do fluxy
/// deprecado. Os valores de negócio reais (GERENTE | SUPERVISOR | ATENDENTE) são
/// um union type TypeScript (src/domain/enums/member-role.ts), validados e
/// SEMPRE escritos explicitamente pela aplicação (nunca pelo default do Better
/// Auth) — ver CompanyRepository. Administrador NÃO é um valor aqui — é a flag
/// global User.role === "admin" do plugin admin do Better Auth, ortogonal a Member.
enum AttendantStatus {
  ONLINE
  PAUSED
  OFFLINE
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime     @default(now())

  /// Presença do atendente no Fluxy Desk — ONLINE/OFFLINE são sempre
  /// automáticos (conexão/desconexão do WebSocket do Desk-API); PAUSED é a
  /// única escolha manual do próprio atendente. Nunca fica sem valor: default
  /// OFFLINE cobre quem nunca conectou.
  status          AttendantStatus @default(OFFLINE)
  statusUpdatedAt DateTime?

  /// Bloqueio temporário do acesso a ESTA empresa (não afeta outras empresas
  /// do usuário nem é o ban global de plataforma do Better Auth) — reversível
  /// por um Gerente/Administrador, ao contrário de excluir o Member (que exige
  /// um novo convite pra voltar). Verificado na resolução da sessão (ver
  /// session.ts#getAuthUser): membro bloqueado nunca ganha activeMemberRole,
  /// então perde acesso a toda ação que exige PermissionAction nesta empresa.
  blocked Boolean @default(false)

  /// Telas liberadas pra este usuário nesta empresa, escolhidas por checkbox
  /// na tela de Acessos — lista de PermissionAction. null = segue o padrão
  /// do papel (PERMISSION_MATRIX). Só cobre as ações configuráveis
  /// (CONFIGURABLE_PERMISSIONS); Acessos/empresas continuam presos ao papel.
  /// Ver resolvePermissions em application/authorization/permission-matrix.ts.
  permissions Json?

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

/// Convite por código (distinto do model Invitation acima, que é o convite por
/// e-mail do plugin organization do Better Auth). O Gerente gera um code único
/// na tela de Acessos escolhendo o papel (role) e o e-mail da pessoa
/// convidada, e repassa o code por fora (ex: WhatsApp) para ela digitar na
/// tela de cadastro. O resgate só é aceito se o e-mail da conta que está
/// resgatando bater com `email` — o code sozinho não basta.
/// finish=true ⇒ code ainda não utilizado; finish=false ⇒ já resgatado — nesse
/// caso userId aponta pra quem resgatou. Nunca é reaberto: um code gasto vira
/// histórico, um novo convite exige gerar outro code.
model InvitationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String       @unique
  email          String
  role           String
  finish         Boolean      @default(true)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([email])
  @@map("invitation_member")
}

// ---------- AGENT ----------

/// Todo agente tem 6 campos de mensagem. processingMessage, transferMessage e
/// unsupportedFormatMessage são OBRIGATÓRIOS (sem toggle — sempre ativos). Os
/// outros 3 (outOfHours/closing/error) têm um par mensagem+enabled: se
/// enabled=false, a IA gera a resposta livremente naquele cenário.
model Agent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  isActive       Boolean      @default(true)

  /// Obrigatória, sem toggle de desativação.
  processingMessage String

  /// Obrigatória, sem toggle de desativação. Enviada pelo Desk-Worker ao criar
  /// o ticket como WAITING (uma única vez por ticket).
  transferMessage String

  /// Obrigatória, sem toggle de desativação.
  unsupportedFormatMessage String

  /// Obrigatória, sem toggle de desativação. Enviada no lugar da IA/atendente
  /// quando o Target que mandou a mensagem tem este agente na sua
  /// blockedAgentIds (ver Target.blockedAgentIds).
  blockedMessage String

  outOfHoursMessage String
  outOfHoursEnabled Boolean @default(true)

  closingMessage String
  closingEnabled Boolean @default(true)

  errorMessage String
  errorEnabled Boolean @default(true)

  defaultQueueId String?
  defaultQueue   Queue?  @relation(fields: [defaultQueueId], references: [id], onDelete: SetNull)

  /// Molda o tom/estilo de comunicação do agente — sempre injetado no prompt de
  /// geração de resposta. Nullable, mas a aplicação sempre preenche um default
  /// na criação (nunca fica vazio de verdade), igual às mensagens acima.
  personality String?

  /// Liga a busca em base de conhecimento (RAG) pros workers Python genéricos
  /// (ex: AI-Worker/max) — quando true, o worker inclui a tool de consulta à
  /// base vetorial e o agente consulta os RagDocument anexados abaixo.
  ragEnabled   Boolean @default(false)
  /// Tamanho (em caracteres) usado ao quebrar os documentos anexados em chunks
  /// — só relevante quando ragEnabled=true.
  ragChunkSize Int?

  /// Tokens de terceiro usados pelo AI-Worker deste agente especificamente —
  /// OpenAI (busca RAG) e Gemini (geração via ADK do Google). Sempre cifrados
  /// (AES-256-GCM, ver infrastructure/crypto/token-cipher.ts); nunca gravados
  /// nem devolvidos em claro pela API — a UI só vê os 6 primeiros chars (ver
  /// sanitizeAgent em agents.routes.ts). O Inbound-Service decifra na hora de
  /// montar o payload publicado pro AI-Worker (nunca usa isso direto do env).
  openaiTokenEncrypted String?
  geminiTokenEncrypted String?

  /// Soft delete — mesmo padrão de Queue.deletedAt, mas SEM o fallback pra
  /// hard-delete que Queue tem: Agent nunca é apagado de verdade, porque
  /// Channel.agent tem onDelete: Cascade (apagar o Agent de verdade
  /// levaria junto o(s) canal(is), ilha(s), filas, contatos... uma cascata
  /// grande demais pra arriscar). Por isso o service BLOQUEIA a exclusão
  /// enquanto existir qualquer Channel apontando pra este agente, em
  /// vez de soft-deletar por baixo do pano. null = agente ativo normalmente.
  /// Some de toda listagem/seleção de configuração (lista de agentes,
  /// vínculo de WhatsApp Channel) mas continua resolvível por id — filtros e
  /// telas de informação (ex: agente de uma campanha antiga) continuam
  /// mostrando ele normalmente.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  whatsappChannels Channel[]
  ragDocuments     RagDocument[]
  campaigns        Campaign[]

  @@index([organizationId])
  @@index([defaultQueueId])
}

// ---------- RAG (BASE DE CONHECIMENTO) ----------

enum RagDocumentStatus {
  PROCESSING
  READY
  FAILED
}

/// Metadados de um documento anexado à base de conhecimento de um agente — o
/// conteúdo (chunks + embeddings) mora só no Postgres+pgvector que o AI-Worker
/// já usa (collection documentos_<nome-do-agente>), nunca aqui. Só o worker
/// Python (via HTTP interno) lê/escreve chunks de verdade; este model é só o
/// rastro/status pra UI mostrar progresso.
model RagDocument {
  id             String            @id @default(cuid())
  agentId        String
  agent          Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  organizationId String
  fileName       String
  s3Key          String
  categories     String[]
  chunkSize      Int
  status         RagDocumentStatus @default(PROCESSING)
  chunkCount     Int?
  errorMessage   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
}

// ---------- WHATSAPP CHANNEL ----------

model Channel {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Nullable desde que openAgent existe: um canal pode não ter nenhum
  /// agente de IA vinculado (atendimento 100% humano). Quando presente,
  /// segue significando "o agente configurado para este canal" — só é
  /// consultado pelo Inbound-Service quando openAgent=true.
  agentId String?
  agent   Agent?  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  /// Se true, o Inbound-Service manda as mensagens recebidas neste canal pro
  /// agente de IA (agentId). Se false, ignora o agente (mesmo que exista) e
  /// manda direto pro atendimento humano, abrindo ticket na fila
  /// idServiceIslandDefault (ver webhook-service.ts). Default false; a UI de
  /// criação do canal já liga automaticamente pra true quando um agente é
  /// selecionado na hora de cadastrar o canal.
  openAgent Boolean @default(false)

  /// Apesar do nome, guarda o id de uma Queue (fila) — não de uma
  /// ServiceIsland. É a fila que recebe o atendimento (abre ticket) quando
  /// openAgent=false. Nome mantido assim por decisão de produto. Sempre
  /// preenchida automaticamente na criação do canal com a fila "Default" da
  /// ilha recém-criada (toda ilha nasce com uma).
  idServiceIslandDefault String?
  queueDefault           Queue?  @relation(fields: [idServiceIslandDefault], references: [id], onDelete: SetNull)

  phoneNumberId   String  @unique
  displayNumber   String
  /// WhatsApp Business Account ID — usado exclusivamente para buscar os
  /// templates aprovados pela Meta deste canal. Não é único: um WABA pode ter
  /// vários números de telefone, cada um virando seu próprio Channel.
  wabaId          String
  /// Token de acesso da Meta para este WABA — informado pelo usuário no
  /// cadastro/busca do canal. Nunca retornado em claro pela API (ver
  /// whatsapp-channels.routes.ts); usado pelo Outbound-Worker/Campaign-Worker
  /// para autenticar o envio na Graph API.
  metaAccessToken String?

  /// Palavras/frases-chave (case/acento-insensitive) que, quando o contato
  /// manda uma mensagem igual a uma delas, disparam o reset de jornada
  /// (apaga todas as sessões do ADK do contato + Target.metadata) em vez de
  /// seguir pro agente de IA — ver AI-Worker/Piloto (consumer.py). Vazio =
  /// funcionalidade desligada para este canal.
  wordsToReset String[] @default([])
  /// Mensagem enviada ao contato depois do reset de jornada (ver wordsToReset
  /// acima). null/vazio = usa a mensagem padrão fixa no Piloto (consumer.py).
  resetMessage String?

  /// Frases que, quando um contato responde a um disparo de campanha deste
  /// canal com uma delas, marcam o contato como bloqueado de futuras
  /// campanhas NESTE canal (ver TargetBlockCampaign abaixo e
  /// Inbound-Service/src/application/webhook/campaign-response-service.ts).
  /// Só é avaliado quando useWordsToBlockCampaign=true.
  wordsToBlockCampaign    String[] @default([])
  /// Liga/desliga a avaliação de wordsToBlockCampaign para este canal.
  /// Default false — canal precisa ativar explicitamente na tela de
  /// Configurações de campanhas.
  useWordsToBlockCampaign Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceIsland        ServiceIsland?
  targets              Target[]
  campaigns            Campaign[]
  targetBlockCampaigns TargetBlockCampaign[]

  @@index([organizationId])
  @@index([agentId])
  @@index([wabaId])
  @@index([idServiceIslandDefault])
}

// ---------- ILHA DE ATENDIMENTO ----------

/// Cada WhatsApp Channel tem exatamente uma ilha de atendimento (1:1).
model ServiceIsland {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  whatsappChannelId String       @unique
  whatsappChannel   Channel      @relation(fields: [whatsappChannelId], references: [id], onDelete: Cascade)
  name              String

  /// Se true, o Desk-Worker/Desk-API recusa encerrar um ticket de qualquer fila
  /// desta ilha sem uma TicketCloseTag selecionada.
  requireCloseTag     Boolean @default(false)
  /// Se true, atendentes de qualquer fila desta ilha podem disparar campanha
  /// ativa pelo Fluxy Desk (ver Desk-API POST /dispatch).
  allowActiveDispatch Boolean @default(false)
  /// Se false, atendentes de qualquer fila desta ilha não conseguem enviar
  /// áudio (gravado ou anexado) nos tickets — ver Desk-API ticket-service.sendMessage.
  allowAudioMessages  Boolean @default(true)
  /// Se true, o Desk-Worker assina toda mensagem de texto do atendente com o
  /// nome dele em negrito (*Nome:*) numa linha acima do texto — ver Desk-Worker
  /// handle-desk-message-outbound.ts.
  useAttendantSignature Boolean @default(false)
  /// Se true, atendentes das filas desta ilha podem adicionar/remover o
  /// contato do ticket em carteiras de atendimento pelo Desk (ver Desk-API
  /// GET/PUT /tickets/:id/carteiras). Usuários do portal podem sempre.
  allowAttendantCarteira Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  queues                Queue[]
  closeTags             TicketCloseTag[]
  preConfiguredMessages PreConfiguredMessage[]

  @@index([organizationId])
}

/// Tag de fechamento cadastrada por ilha de atendimento — gerida no Agent
/// Console, usada pelo atendente no Desk Console ao encerrar um ticket.
model TicketCloseTag {
  id              String        @id @default(cuid())
  serviceIslandId String
  serviceIsland   ServiceIsland @relation(fields: [serviceIslandId], references: [id], onDelete: Cascade)
  name            String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]

  @@unique([serviceIslandId, name])
  @@index([serviceIslandId])
}

/// Mensagem pronta cadastrada por ilha de atendimento e vinculada a uma ou
/// mais filas — gerida no Agent Console, usada pelo atendente no Desk Console
/// como atalho ao responder um ticket. content pode conter **negrito**,
/// convertido pro *negrito* de verdade do WhatsApp só na hora de inserir no
/// campo de mensagem do Desk (nunca persistido já convertido).
model PreConfiguredMessage {
  id              String        @id @default(cuid())
  serviceIslandId String
  serviceIsland   ServiceIsland @relation(fields: [serviceIslandId], references: [id], onDelete: Cascade)
  name            String
  content         String

  /// Filas em que essa mensagem fica disponível pro atendente. "Selecionar
  /// todas" no formulário é só conveniência de UI — marca as filas que
  /// existem no momento da criação, não é uma flag que reaplica sozinha em
  /// filas criadas depois.
  queues Queue[] @relation("PreConfiguredMessageQueues")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceIslandId, name])
  @@index([serviceIslandId])
}

model Queue {
  id              String        @id @default(cuid())
  serviceIslandId String
  serviceIsland   ServiceIsland @relation(fields: [serviceIslandId], references: [id], onDelete: Cascade)
  name            String

  /// Horário de atendimento personalizado desta fila.
  businessHoursEnabled Boolean @default(false)
  businessHoursStart   String? // "HH:mm"
  businessHoursEnd     String? // "HH:mm"
  businessDays         Int[]   @default([1, 2, 3, 4, 5]) // 0=domingo..6=sábado

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Soft delete: fila com histórico de ticket não pode ser apagada de
  /// verdade (Ticket.queueId cascadeia on delete — perderia o histórico de
  /// atendimento). Em vez disso fica marcada aqui e some de toda listagem
  /// voltada pro usuário (a linha continua existindo só pros tickets antigos
  /// continuarem apontando pra ela). null = fila ativa normalmente.
  deletedAt DateTime?

  /// Marca a fila "Default" criada automaticamente junto com a ilha de
  /// atendimento (ver ServiceIsland/whatsapp-channel-service.ts) — nunca pode
  /// ser excluída (nem soft nem hard delete; ver queue-service.ts). No máximo
  /// uma por ilha, mas isso não é reforçado por constraint, só pela criação
  /// controlada (a fila nunca nasce assim por fora do fluxo automático).
  isDefault Boolean @default(false)

  /// Só fila com esta flag pode ser escolhida como destino de uma Carteira.
  /// Desligar depois não apaga as carteiras, só faz o roteamento ignorá-las
  /// (ver Desk-Worker find-or-create-open-ticket.ts#resolveCarteiraQueueId).
  carteiraEnabled Boolean @default(false)

  members               QueueMember[]
  carteiras             Carteira[]
  tickets               Ticket[]
  defaultForAgents      Agent[]
  defaultForChannels    Channel[]
  campaignsRoutedHere   Campaign[]             @relation("CampaignRouteToQueue")
  preConfiguredMessages PreConfiguredMessage[] @relation("PreConfiguredMessageQueues")

  @@index([serviceIslandId])
}

/// Carteira de atendimento: todo ticket novo de um contato listado em
/// targetIds vai pra queueId em vez da fila original (ver Desk-Worker
/// find-or-create-open-ticket.ts). A fila precisa ter carteiraEnabled=true.
model Carteira {
  id        String   @id @default(cuid())
  name      String
  queueId   String
  queue     Queue    @relation(fields: [queueId], references: [id], onDelete: Cascade)
  /// Ids de Target (mesma empresa da fila) que pertencem a esta carteira.
  targetIds String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([queueId])
  @@index([targetIds], type: Gin)
}

model QueueMember {
  id        String   @id @default(cuid())
  queueId   String
  queue     Queue    @relation(fields: [queueId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([queueId, userId])
  @@index([userId])
}

// ---------- TARGET (CONTATO) ----------

enum TargetStatus {
  AI
  HUMAN
  FINISHED
}

model Target {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  whatsappChannelId String
  whatsappChannel   Channel      @relation(fields: [whatsappChannelId], references: [id], onDelete: Cascade)

  /// Business-Scoped User ID (contacts[].user_id no webhook da Meta) —
  /// identidade estável do contato, presente em todo webhook desde abr/2026,
  /// independente de o usuário ter ativado @username ou não. É o vínculo
  /// principal de um Target (ver Inbound-Service/target-service.ts); wa_id
  /// pode ficar ausente quando o usuário ativa username + privacidade de
  /// telefone. Nullable só porque Target criado manualmente (POST /targets)
  /// não tem BSUID até o contato mandar mensagem de verdade pelo WhatsApp.
  bsuid String?

  /// wa_id da Meta (telefone normalizado) — agora OPCIONAL: a Meta omite
  /// esse campo quando o contato ativou @username e não há troca de
  /// mensagem/telefone nos últimos 30 dias. Preenchido oportunisticamente
  /// (nunca apagado por uma mensagem futura que venha sem telefone).
  waId     String?
  name     String?
  email    String?
  /// Pares key:value livres, editáveis no Agent Console (leitura) e Desk Console
  /// (edição), via input de chave + input de valor.
  metadata Json?

  status             TargetStatus @default(AI)
  firstInteractionAt DateTime     @default(now())
  lastInteractionAt  DateTime?

  /// Ids de Agent (mesma organização) que este contato está bloqueado de
  /// falar — quando o Agent do canal atual está nesta lista, a mensagem
  /// recebida não é roteada pra IA nem pra atendente, só responde com
  /// Agent.blockedMessage (ver Inbound-Service/webhook-service.ts). Editável
  /// só por Supervisor/Gerente via PATCH /:id/blocked-agents.
  blockedAgentIds String[] @default([])

  /// Quando true, este Target é excluído do envio de campanhas
  /// (Campaign-Service não seleciona este Target como destinatário).
  blockCampaigns Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messagingSessions    MessagingSession[]
  tickets              Ticket[]
  campaignTargets      CampaignTarget[]
  targetBlockCampaigns TargetBlockCampaign[]
  cardCrm              CardCrm?
  calendarEvents       CalendarEvent[]

  /// bsuid é o vínculo principal (Postgres não colide NULLs entre si, então
  /// múltiplos Target sem bsuid/waId ainda cabem nos dois índices sem briga).
  @@unique([organizationId, whatsappChannelId, bsuid])
  @@unique([organizationId, whatsappChannelId, waId])
  @@index([organizationId])
  @@index([whatsappChannelId])
}

// ---------- SESSÃO DE MENSAGERIA (janela de 24h) ----------

enum SessionOrigin {
  CUSTOMER_MESSAGE
  CAMPAIGN_TEMPLATE
}

/// Uma linha por janela de atendimento. Nunca é apagada nem "fechada" com uma
/// flag — a expiração das 24h é SEMPRE calculada em runtime a partir de
/// lastCustomerMessageAt. Reengajamento (template aprovado ou nova mensagem do
/// próprio cliente) sempre cria uma NOVA linha; a anterior fica só para
/// histórico/auditoria.
model MessagingSession {
  id                String @id @default(cuid())
  targetId          String
  target            Target @relation(fields: [targetId], references: [id], onDelete: Cascade)
  whatsappChannelId String

  createdVia             SessionOrigin @default(CUSTOMER_MESSAGE)
  startedAt              DateTime      @default(now())
  lastCustomerMessageAt  DateTime      @default(now())
  lastAttendantMessageAt DateTime?

  createdAt DateTime @default(now())

  tickets Ticket[]

  @@index([targetId])
  @@index([whatsappChannelId])
}

// ---------- CAMPANHA (DISPARO ATIVO DE TEMPLATE) ----------

enum CampaignStatus {
  PROCESSING
  COMPLETED
}

enum CampaignTargetStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum CampaignDispatchType {
  CSV
  MANUAL
}

/// Disparo em massa (ou manual, de 1 contato) de um template aprovado da Meta.
/// Criada de forma síncrona pelo Agent-Api (já retorna com id) e enfileirada no
/// Campaign-Worker, que processa contato a contato e vai incrementando os
/// contadores abaixo até virar COMPLETED.
model Campaign {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  whatsappChannelId String
  whatsappChannel   Channel      @relation(fields: [whatsappChannelId], references: [id], onDelete: Cascade)
  /// Snapshot do agente que atendeu no momento do disparo — resolvido do
  /// whatsappChannel.agentId ATUAL na hora de criar a Campaign (ver
  /// campaign-service.ts#dispatch) e nunca mais tocado depois. Existe pra que
  /// trocar o agente vinculado ao canal não reescreva retroativamente qual
  /// agente aparece no histórico de campanhas já disparadas — sempre ler o
  /// agente pela Campaign, nunca pelo whatsappChannel.agent atual.
  agentId           String
  agent             Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)

  name         String
  category     String?
  templateName String
  language     String

  status       CampaignStatus       @default(PROCESSING)
  dispatchType CampaignDispatchType @default(CSV)

  /// Quantidade de contatos que a campanha deveria atingir — definido na criação
  /// (síncrona), antes do worker processar o lote. totalContacts é o quanto já
  /// foi processado (sucesso ou falha).
  expectedContacts Int @default(0)
  totalContacts    Int @default(0)
  totalSent        Int @default(0)
  totalFailures    Int @default(0)

  /// Quem disparou, vindo da sessão do Agent Console.
  createdByUserId String?
  createdByName   String?
  createdByEmail  String?

  /// Se preenchido, cada contato atingido com sucesso vira um Ticket nesta
  /// fila (via desk.ticket.create, mesmo mecanismo do handoff de IA) e o
  /// Target correspondente vira HUMAN em vez de continuar na IA.
  routeToQueueId String?
  routeToQueue   Queue?  @relation("CampaignRouteToQueue", fields: [routeToQueueId], references: [id], onDelete: SetNull)
  /// Só usado se routeToQueueId estiver preenchido — atendente já assume o
  /// ticket (IN_PROGRESS) em vez de cair WAITING na fila.
  routeToUserId  String?
  routeToUser    User?   @relation("CampaignRouteToUser", fields: [routeToUserId], references: [id], onDelete: SetNull)

  sentAt    DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  targets CampaignTarget[]

  @@index([organizationId])
  @@index([whatsappChannelId])
  @@index([agentId])
  @@index([routeToQueueId])
  @@index([routeToUserId])
}

/// Uma linha por contato disparado dentro de uma campanha.
model CampaignTarget {
  id         String               @id @default(cuid())
  campaignId String
  campaign   Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  targetId   String
  target     Target               @relation(fields: [targetId], references: [id], onDelete: Cascade)
  status     CampaignTargetStatus @default(SENT)

  /// Corpo cru da resposta da Meta (debug de falhas).
  response  String?
  /// wamid retornado pela Meta ao enviar o template.
  messageId String?
  /// Snapshot das variáveis (header/body/button) preenchidas para esse contato —
  /// usado para reexibir o template completo no histórico de conversa.
  variables Json?

  /// true quando o contato já respondeu este disparo — setado pelo
  /// Inbound-Service ao receber uma mensagem do cliente enquanto ainda existe
  /// um CampaignTarget seu com respondedCampaign=false (ver
  /// Inbound-Service/src/application/webhook/campaign-response-service.ts).
  /// Processo assíncrono (fire-and-forget), não bloqueia o fluxo do webhook.
  respondedCampaign Boolean @default(false)
  /// Texto da mensagem do cliente que gerou a resposta acima. null enquanto
  /// respondedCampaign=false.
  campaignResponse  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([messageId])
  @@index([targetId, respondedCampaign])
}

/// Bloqueio automático de um contato para campanhas de um canal específico —
/// criado pelo Inbound-Service quando o contato responde a um disparo com uma
/// das frases de Channel.wordsToBlockCampaign (só avaliado quando
/// Channel.useWordsToBlockCampaign=true). Consultado pelo Agent-Api na hora
/// de montar um novo disparo (ver campaign-service.ts#findBlockedPhones) para
/// avisar o usuário e excluir esses contatos da lista antes de enviar.
model TargetBlockCampaign {
  id                String  @id @default(cuid())
  targetId          String
  target            Target  @relation(fields: [targetId], references: [id], onDelete: Cascade)
  whatsappChannelId String
  whatsappChannel   Channel @relation(fields: [whatsappChannelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Um bloqueio por par (contato, canal) — respostas repetidas com frases de
  /// bloqueio não duplicam a linha.
  @@unique([targetId, whatsappChannelId])
  @@index([whatsappChannelId])
}

// ---------- TICKET (ATENDIMENTO HUMANO) ----------

enum TicketStatus {
  WAITING
  IN_PROGRESS
  CLOSED
}

enum TicketCloseReason {
  RESOLVED
  TRANSFERRED_QUEUE
  TRANSFERRED_AGENT
  SESSION_EXPIRED
  ABANDONED
}

model Ticket {
  id                 String           @id @default(cuid())
  /// Sequencial por organização, gerado via TicketCounter (upsert atômico).
  ticketNumber       Int
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  queueId            String
  queue              Queue            @relation(fields: [queueId], references: [id], onDelete: Cascade)
  targetId           String
  target             Target           @relation(fields: [targetId], references: [id], onDelete: Cascade)
  messagingSessionId String
  messagingSession   MessagingSession @relation(fields: [messagingSessionId], references: [id], onDelete: Cascade)

  status TicketStatus @default(WAITING)

  /// null = em espera, visível a todos os atendentes da fila. Preenchido =
  /// atendente que "puxou" o ticket (claim atômico, ver migration para o
  /// índice único parcial que impede mais de um ticket aberto por sessão).
  assignedUserId String?
  assignedUser   User?     @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignedAt     DateTime?

  /// Ticket que originou este (transferência de fila ou de atendente fecha o
  /// ticket atual e cria um novo, nunca faz update in-place).
  transferredFromTicketId String?
  transferredFromTicket   Ticket?  @relation("TicketTransferChain", fields: [transferredFromTicketId], references: [id], onDelete: SetNull)
  transferredToTickets    Ticket[] @relation("TicketTransferChain")

  closeReason TicketCloseReason?

  /// Tag de fechamento escolhida pelo atendente (opcional, a menos que a ilha
  /// exija — ver ServiceIsland.requireCloseTag). SetNull preserva o ticket se
  /// a tag for excluída depois.
  closeTagId String?
  closeTag   TicketCloseTag? @relation(fields: [closeTagId], references: [id], onDelete: SetNull)

  /// Throttle do reenvio de transferMessage enquanto o ticket está WAITING.
  lastWaitingMessageSentAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  messages TicketMessage[]

  @@unique([organizationId, ticketNumber])
  @@index([queueId])
  @@index([targetId])
  @@index([messagingSessionId])
  @@index([assignedUserId])
  @@index([closeTagId])
}

/// Guarda o último ticketNumber emitido por organização. Incrementado via
/// upsert na mesma transação que cria o Ticket (INSERT ... ON CONFLICT DO
/// UPDATE, atômico sob concorrência).
model TicketCounter {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lastNumber     Int          @default(0)
}

enum TicketMessageSender {
  CUSTOMER
  ATTENDANT
  SYSTEM
}

enum MessageType {
  TEXT
  AUDIO
  IMAGE
  DOCUMENT
  STICKER
  VIDEO
}

/// Rastro (ids + tipo, sem conteúdo — o conteúdo mora no Mongo) de cada
/// mensagem trocada dentro de um ticket.
model TicketMessage {
  id             String              @id @default(cuid())
  ticketId       String
  ticket         Ticket              @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderType     TicketMessageSender
  senderUserId   String?
  /// _id do documento correspondente na collection `messages` do Mongo.
  mongoMessageId String?
  messageType    MessageType         @default(TEXT)
  createdAt      DateTime            @default(now())

  @@index([ticketId])
}

// ---------- DEDUP DE MENSAGENS INBOUND ----------

/// Cada mensagem recebida da Meta só pode ser processada uma vez. Antes de
/// processar, o Inbound-Service verifica se o id externo já está aqui.
model ProcessedInboundMessage {
  id                String   @id @default(cuid())
  externalMessageId String   @unique
  whatsappChannelId String
  processedAt       DateTime @default(now())

  @@index([whatsappChannelId])
}

// ---------- OBSERVABILIDADE ----------

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  userId         String
  action         String
  resourceType   String
  resourceId     String
  beforeState    Json?
  afterState     Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime      @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([resourceType, resourceId])
}

/// Rastreamento de uma mensagem passando pelos serviços da mensageria
/// (Inbound-Service, AI-Worker, Desk-Worker, Outbound-Worker,
/// Notification-Worker, Campaign-Worker) — uma linha de "start" e uma de
/// "end" por serviço que processa aquela mensagem, ver MENSAGERIA.md. Sem
/// FK: messageId aponta pro _id da mensagem no Mongo (collection `messages`)
/// ou, quando o estágio ainda não tem esse id, pro identificador disponível
/// naquele momento (ex: externalMessageId da Meta) — cada serviço documenta
/// no próprio código qual id está usando em cada estágio.
model MessageLog {
  id         String   @id @default(cuid())
  messageId  String
  createdAt  DateTime @default(now())
  /// Nome do serviço/estágio que gravou esta linha (ex: "Inbound Service",
  /// "AI Worker - Piloto", "Desk Worker", "Outbound Worker",
  /// "Notification Worker", "Campaign Worker").
  messageLog String
  /// "start" | "end" — livre (não enum) pra não exigir migration a cada novo
  /// serviço/estágio adicionado.
  stagio     String

  @@index([messageId])
  @@index([messageLog, stagio])
}

model ErrorLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  userId         String?
  route          String
  message        String
  stack          String?
  statusCode     Int
  createdAt      DateTime      @default(now())

  @@index([organizationId])
  @@index([route])
}

/// Todo empresa nasce com o seu CRM já criado (ver company-service.ts#create)
/// — 1:1 com Organization.
model CrmToBusiness {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stagesCrm StagesCrm[]
  cards     CardCrm[]
}

/// Coluna do Kanban de CRM. position é definida pelo usuário na criação
/// (inteiro >= 1, único por CRM — ver crm-service.ts#createStage pro
/// deslocamento automático quando a posição já está ocupada).
model StagesCrm {
  id              String        @id @default(cuid())
  nameStage       String
  position        Int
  crmToBusinessId String
  crmToBusiness   CrmToBusiness @relation(fields: [crmToBusinessId], references: [id], onDelete: Cascade)

  /// Marca o estágio "Início" criado junto com o CRM (ver
  /// company-service.ts#create) — todo lead novo nasce nele (mesmo padrão de
  /// Queue.isDefault).
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cards CardCrm[]

  @@unique([crmToBusinessId, position])
  @@index([crmToBusinessId])
}

/// Prioridade de atenção do card no CRM, escolhida pelo usuário.
enum CardPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Um card por Target (1:1) — criado automaticamente pelo Inbound-Service
/// assim que o Target nasce (ver Inbound-Service/src/application/webhook/
/// crm-card-service.ts), sempre no estágio isDefault=true.
model CardCrm {
  id              String        @id @default(cuid())
  targetId        String        @unique
  target          Target        @relation(fields: [targetId], references: [id], onDelete: Cascade)
  crmToBusinessId String
  crmToBusiness   CrmToBusiness @relation(fields: [crmToBusinessId], references: [id], onDelete: Cascade)
  stagesCrmId     String?
  stagesCrm       StagesCrm?    @relation(fields: [stagesCrmId], references: [id], onDelete: SetNull)

  /// Chaves S3 (não URLs) dos arquivos anexados ao card — o Agent-Api gera a
  /// URL presignada de leitura na hora de devolver o card (ver
  /// crm-service.ts#getCard), então funciona com bucket privado.
  attachments String[] @default([])

  statusPriority CardPriority @default(LOW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments CardCrmComment[]

  @@index([crmToBusinessId])
  @@index([stagesCrmId])
}

/// Comentário deixado por qualquer usuário da empresa no card do CRM.
model CardCrmComment {
  id        String   @id @default(cuid())
  cardCrmId String
  cardCrm   CardCrm  @relation(fields: [cardCrmId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   String
  createdAt DateTime @default(now())
  /// Muda a cada edição do autor — o Agent Console mostra "(editado)" quando
  /// passa de createdAt (ver crm-card-detail-drawer.tsx#wasEdited).
  updatedAt DateTime @updatedAt

  @@index([cardCrmId])
  @@index([userId])
}

/// Funil de conversões da empresa (1:1 com Organization, criado sob demanda
/// na primeira vez que a aba "Funil de conversões" é aberta — ver
/// crm-funnel-service.ts#getOrCreateFunil).
model Funil {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fields FieldsFunil[]
}

/// Etapa do funil: aponta pra uma chave de Target.metadata. Com
/// useValue=false, conta como convertido todo contato que tem a chave
/// preenchida; com useValue=true, só quem tem exatamente `value` nela.
model FieldsFunil {
  id       String  @id @default(cuid())
  name     String
  value    String?
  useValue Boolean @default(false)
  funilId  String
  funil    Funil   @relation(fields: [funilId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([funilId])
}

/// Calendário de eventos da empresa (aba "Calendário" do Kanban Board) —
/// 1:1 com Organization, criado sob demanda na primeira vez que a aba abre
/// (ver crm-calendar-service.ts#getOrCreateCalendar).
model CalendarOrganization {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events CalendarEvent[]
}

/// Situação final de um evento. null = ainda agendado (nenhuma das três).
enum EventStatus {
  FINISHED
  RESCHEDULED
  CANCELED
}

/// Evento do calendário, sempre ligado a um contato (Target).
model CalendarEvent {
  id                     String               @id @default(cuid())
  calendarOrganizationId String
  calendarOrganization   CalendarOrganization @relation(fields: [calendarOrganizationId], references: [id], onDelete: Cascade)
  targetId               String
  target                 Target               @relation(fields: [targetId], references: [id], onDelete: Cascade)

  dateEvent   DateTime
  name        String
  description String?
  /// Evento encerrado (não aceita mais alteração de data/dados pela tela).
  isClosed    Boolean      @default(false)
  status      EventStatus?

  /// Chaves S3 (não URLs) dos documentos do evento — mesma regra de
  /// CardCrm.attachments: a URL presignada é gerada na hora de devolver.
  documents String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  annotations CalendarEventAnnotation[]

  @@index([calendarOrganizationId, dateEvent])
  @@index([targetId])
}

/// Anotação deixada por um usuário no evento — editar/apagar só pelo autor.
model CalendarEventAnnotation {
  id        String        @id @default(cuid())
  eventId   String
  event     CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([userId])
}
