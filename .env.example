PORT=7073
NODE_ENV=development

DATABASE_URL="postgres://user:password@host:5432/orquestrador?sslmode=disable"

BETTER_AUTH_SECRET=
BETTER_AUTH_URL="http://localhost:7073"

CORS_ALLOWED_ORIGINS="https://agentes.sturnusflow.com.br,https://desk.sturnusflow.com.br,http://localhost:7072,http://localhost:7080"

INTERNAL_API_KEY=

# 32 bytes em base64 (ex: `openssl rand -base64 32`). PRECISA ser idêntica no
# Inbound-Service — os dois cifram/decifram os tokens por agente com essa chave.
AGENT_TOKEN_ENCRYPTION_KEY=

REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

RABBITMQ_URL="amqp://user:password@host:5672"

MONGO_URL="mongodb://user:password@host:27017/?tls=false"
MONGO_DB_NAME=orquestrador

SEAWEEDFS_S3_ENDPOINT=
SEAWEEDFS_S3_ACCESS_KEY=
SEAWEEDFS_S3_SECRET_KEY=
SEAWEEDFS_S3_BUCKET=
SEAWEEDFS_S3_REGION=us-east-1
SEAWEEDFS_S3_PREFIX=fluxy-saas/agent-api

APP_TIMEZONE=America/Sao_Paulo

META_GRAPH_API_VERSION=v21.0

CAMPAIGN_WORKER_URL="http://localhost:7082"

# Metrópole — WhatsApp Channel do agente "max" (POST /internal/campaigns/metropole-welcome)
METROPOLE_WHATSAPP_CHANNEL_ID=
METROPOLE_WELCOME_TEMPLATE_NAME=metropole_boas_vindas
METROPOLE_WELCOME_TEMPLATE_LANGUAGE=pt_BR
METROPOLE_WELCOME_TEMPLATE_CATEGORY=MARKETING

# Conta Gmail usada para enviar o e-mail de redefinição de senha.
# PASSWORD_GOOGLE é uma senha de app do Gmail, não a senha normal da conta.
GMAIL_USER=
PASSWORD_GOOGLE=

# URL pública do Agent Console — links dos e-mails de notificação do suporte técnico
CONSOLE_URL=https://agentes.sturnusflow.com.br

# E-mails que são sempre Administrador da plataforma (time de suporte), separados por vírgula
PLATFORM_ADMIN_EMAILS=sturnusflow@gmail.com
